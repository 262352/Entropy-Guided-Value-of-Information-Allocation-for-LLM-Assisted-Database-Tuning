# Host machine running the proxy.
HOST_IP=203.0.113.10
HOST_GATEWAY=172.17.0.1
# Working host proxy port for Codex.
PROXY_PORT=7890
FALLBACK_PORT=7890
SSH_HOST=172.17.0.1
SSH_PORT=22
SSH_USER=root
